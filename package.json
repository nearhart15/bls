    "json2typescript": "^1.6.1",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-router": "^8.3.0",
    "simple-statistics": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
